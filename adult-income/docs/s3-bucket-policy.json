{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": { "Service": "logs.ap-northeast-2.amazonaws.com" },
      "Action": "s3:GetBucketAcl",
      "Resource": "arn:aws:s3:::<YOUR-BUCKET>"
    },
    {
      "Effect": "Allow",
      "Principal": { "Service": "logs.ap-northeast-2.amazonaws.com" },
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::<YOUR-BUCKET>/*",
      "Condition": { "StringEquals": { "s3:x-amz-acl": "bucket-owner-full-control" } }
    }
  ]
}
